{
  "name": "goat-atlas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.28.5",
  "description": "An open, source-backed career atlas for Cristiano Ronaldo — and eventually every footballer.",
  "repository": {
    "type": "git",
    "url": "https://github.com/haohaohao-cell/goat-atlas.git"
  },
  "homepage": "https://haohaohao-cell.github.io/goat-atlas/",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "prebuild": "node scripts/generate-calendar.mjs && node scripts/generate-era-art.mjs",
    "start": "next start",
    "calendar": "node scripts/generate-calendar.mjs",
    "art": "node scripts/generate-era-art.mjs",
    "typegen": "next typegen",
    "typecheck": "next typegen && tsc --noEmit",
    "sync:live": "node scripts/sync-live.mjs",
    "sync:milestones": "node scripts/sync-milestones.mjs",
    "bot": "node scripts/bot.mjs",
    "validate": "node scripts/validate-data.mjs",
    "check:links": "node scripts/check-links.mjs",
    "audit:media": "node scripts/audit-media.mjs",
    "verify:video": "node scripts/verify-video.mjs"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
