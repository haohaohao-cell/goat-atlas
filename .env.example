# Public site URL, used for canonical links, sitemap and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Shown in the header and footer when set.
NEXT_PUBLIC_GITHUB_URL=

# Server-only. Used by `pnpm sync:live` and GitHub Actions.
# Get a key at https://www.api-football.com/
API_FOOTBALL_KEY=

# Optional overrides for the live sync.
API_FOOTBALL_PLAYER_ID=874
API_FOOTBALL_SEASON=
